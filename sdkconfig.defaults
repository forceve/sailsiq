CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
CONFIG_SAILBALL_BOARD_REVISION="USER_CONFIRMED_MAP_REVISION_UNSPECIFIED"
CONFIG_SAILBALL_GNSS_UART1=y
CONFIG_SAILBALL_GNSS_RX_GPIO=0
CONFIG_SAILBALL_GNSS_TX_GPIO=1
CONFIG_SAILBALL_SD_SPI2_HOST=y
CONFIG_SAILBALL_SD_CS_GPIO=4
CONFIG_SAILBALL_SD_MOSI_GPIO=5
CONFIG_SAILBALL_SD_SCLK_GPIO=6
CONFIG_SAILBALL_SD_MISO_GPIO=7
CONFIG_SAILBALL_BOOT_GPIO=9
CONFIG_SAILBALL_LED_GPIO=8
CONFIG_SAILBALL_GNSS_SAMPLE_RATE_NUM=10
CONFIG_SAILBALL_GNSS_SAMPLE_RATE_DEN=1
CONFIG_SAILBALL_GNSS_RUNTIME_BAUD=115200
CONFIG_SAILBALL_GNSS_UPDATE_RATE_HZ=10
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
# One peripheral link; SP reassembly is static and fragments arrive serially.
# Bounded Peripheral-only pools; retain ATT/GATT and maximum SP fragmentation.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
# STA only: four static RX match the four-frame BA window; dynamic RX remains
# >= static per IDF Kconfig. Four dynamic TX slots serve the single TCP client.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# Sailball v1 supports IPv4 STA with a numeric controller endpoint only.
CONFIG_LWIP_IPV6=n
# Time authority comes from the selected GNSS backend, not SNTP.
# One-controller TCP buffers hold two IPv4 MSS segments per direction.
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
# SPI2 SD transactions use the flash-resident master ISR; cache-off overlap is
# deferred and remains subject to Hardware Validation Phase 1B acceptance.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_GDMA_CTRL_FUNC_IN_IRAM is not set
